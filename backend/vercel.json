{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "python -c \"from app.models import create_tables; create_tables()\" && python run_migrations.py",
  "functions": {
    "app/main.py": {
      "maxDuration": 1800
    }
  },
  "crons": [
    {
      "path": "/internal/cron/surveys",
      "schedule": "* * * * *"
    },
    {
      "path": "/internal/cron/analyses",
      "schedule": "* * * * *"
    },
    {
      "path": "/internal/cron/retention",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/internal/cron/weekly-digest",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/internal/cron/auto-refresh",
      "schedule": "0 * * * *"
    }
  ]
}
